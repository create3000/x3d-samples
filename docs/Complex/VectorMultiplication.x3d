    <Script DEF='VectorMultiplicationScript'
        directOutput='true'>
      <field accessType='inputOutput' type='SFVec2f' name='a' value='0.9812133 1.000004'/>
      <field accessType='inputOutput' type='SFVec2f' name='b' value='-2.019328 1.005206'/>
      <field accessType='outputOnly' type='SFVec2f' name='c_changed'/>
<![CDATA[ecmascript:

function initialized ()
{
   eventsProcessed ();
}

function eventsProcessed (value, time)
{
   const
      { x: ar, y: ai } = a,
      { x: br, y: bi } = b;

   c_changed .x = ar * br - ai * bi;
   c_changed .y = ar * bi + ai * br;
}
]]>
    </Script>
    <ROUTE fromNode='VectorMultiplicationScript' fromField='c_changed' toNode='C' toField='set_vector'/>
    <ROUTE fromNode='A' fromField='vector_changed' toNode='VectorMultiplicationScript' toField='set_a'/>
    <ROUTE fromNode='B' fromField='vector_changed' toNode='VectorMultiplicationScript' toField='set_b'/>
