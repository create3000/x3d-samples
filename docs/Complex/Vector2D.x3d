                    height='0.3'
                    bottomRadius='0.12'/>
              </Shape>
            </Transform>
            <PlaneSensor DEF='_3'>
              <IS>
                <connect nodeField='enabled' protoField='pointerEvents'/>
              </IS>
            </PlaneSensor>
          </Group>
          <Transform DEF='Label'>
            <Billboard
                axisOfRotation='0 0 0'>
              <Shape>
                <Appearance>
                  <UnlitMaterial>
                    <IS>
                      <connect nodeField='emissiveColor' protoField='labelColor'/>
                    </IS>
                  </UnlitMaterial>
                </Appearance>
                <Text
                    solid='true'>
                  <IS>
                    <connect nodeField='string' protoField='label'/>
                  </IS>
                  <FontStyle
                      size='0.35'
                      justify='"MIDDLE", "MIDDLE"'/>
                </Text>
              </Shape>
            </Billboard>
          </Transform>
        </Group>
        <Script DEF='VectorScript'
            directOutput='true'>
          <field accessType='inputOnly' type='SFVec3f' name='set_translation'/>
          <field accessType='inputOutput' type='SFVec2f' name='vector'/>
          <field accessType='initializeOnly' type='SFNode' name='sensor'>
            <PlaneSensor USE='_3'/>
          </field>
          <field accessType='initializeOnly' type='SFNode' name='cylinder'>
            <Transform USE='Cylinder_1'/>
          </field>
          <field accessType='initializeOnly' type='SFNode' name='cone'>
            <Transform USE='Cone'/>
          </field>
          <field accessType='initializeOnly' type='SFNode' name='label'>
            <Transform USE='Label'/>
          </field>
          <IS>
            <connect nodeField='vector' protoField='vector'/>
          </IS>
<![CDATA[ecmascript:

function initialize ()
{
   set_vector ();
}

function set_vector ()
{
   const
      length   = vector .length (),
      rotation = new SFRotation (SFVec3f .Y_AXIS, new SFVec3f (... vector, 0));

   cylinder .scale .y    = length - 0.15;
   cone .translation .y  = length - 0.15;
   cone .center .y       = -(length - 0.15);
   label .translation .y = length + 0.2;
   label .center .y      = -(length + 0.2);

   cylinder .rotation = rotation;
   cone     .rotation = rotation;
   label    .rotation = rotation;

   sensor .offset = new SFVec3f (... vector, 0);
}

function set_translation (value)
{
   vector .x = value .x;
   vector .y = value .y;
}
]]>
